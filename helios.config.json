{
  "//": "manifest 声明顺序即加载顺序（串行）。被依赖的基础 Port（FileSystemPort）必须写在前面。",
  "plugins": [
    { "port": "FileSystemPort", "package": "@helios/fs-node" },
    { "port": "MemoryPort", "package": "@helios/memory-fs" },
    { "port": "CheckpointPort", "package": "@helios/checkpoint-fs" },
    { "port": "CompactStrategyPort", "package": "@helios/compact-default" },
    { "port": "MultiAgentPort", "package": "@helios/teams-mailbox" },
    { "port": "CapabilityProvider", "package": "@helios/capability-fs" },
    {
      "port": "CostMeterPort",
      "package": "@helios/costmeter-default",
      "options": {
        "pricingVersion": "codexapis-2026-08",
        "//pricing": "key 用 '*' 通配：当前 llmOptions 未显式传 model，CostMeter 记的 rec.model 会是空串，精确 key 匹配不到",
        "pricing": {
          "*": {
            "uncachedInput": 0.075,
            "cachedInput": 0.05,
            "cacheWrite": 0.05,
            "output": 0.45
          }
        }
      }
    },
    {
      "port": "LLMProvider",
      "package": "@helios/llm-openai",
      "options": {
        "baseURL": "https://codexapis.com/v1",
        "model": "gpt-5.4-mini"
      }
    }
  ]
}
